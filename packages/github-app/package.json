{
  "name": "github-app",
  "version": "1.0.0",
  "description": "The Warden GitHub App: app JWTs, short-lived installation tokens, repo and branch lists, webhook signature checks. No SDK, just fetch and node:crypto.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
