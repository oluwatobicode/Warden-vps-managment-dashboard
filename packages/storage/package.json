{
  "name": "storage",
  "version": "1.0.0",
  "description": "S3-compatible object storage (Cloudflare R2, AWS S3, local S3Mock) with streaming AES-256-GCM encryption, for database backups.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/lib-storage": "^3.1154.0"
  }
}
