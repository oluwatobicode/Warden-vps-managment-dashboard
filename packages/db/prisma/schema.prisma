generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * Relationships:
 * 1 user belongs to 1 organization (Phase 1 — single-org-per-user; Membership is
 * already shaped so multi-org later just means allowing >1 Membership row per user)
 * 1 organization has many projects, sshKeys, servers, apiTokens, memberships,
 * invitations, notificationChannels, auditLogs
 * 1 project has many environments, apiTokens
 * 1 environment has many services
 * 1 service has many deployments
 * 1 service has 0..1 githubRepoUrl (repo lives on the SERVICE, not the project —
 * two services may share one repo or have their own)
 * 1 environment has many environmentVariables; 1 service has many serviceVariables
 * (service-level overrides environment-level on the same key)
 * 1 service runs on 0..1 server (via serverId — assigned after creation, not on the
 * project-creation form); 1 server runs many services, from any project in the org
 * 1 server belongs to 1 organization (not locked to a single project — a server
 * can run services from more than one project)
 * 1 server has 1 sshKey (via serverSshKeyId); 1 sshKey can be reused across servers
 * 1 auditLog is performed by 0..1 user (nullable + snapshot fields so the log
 * outlives the user)
 * Cascade behavior: deleting an Organization deletes everything under it
 * (projects, servers, keys, tokens, memberships, invitations, notification
 * channels, audit logs) and deleting a Server deletes its metrics/logs/
 * containers/traefik config/docker data — these are pure child records with no
 * standalone meaning. This is a deliberate choice for Phase 1 (simple, no orphaned
 * data) — revisit if you want a "soft delete with grace period" pattern instead
 * before this ships to real users with real infra on the line.
 * Restrict (delete is blocked; the app must catch Prisma error P2003 and tell the
 * user what is still referencing the row):
 * - Server -> SshKey: a key still used by a server can't be deleted. Reassign first.
 * - Service -> Server: a server still running services can't be deleted. Those
 * services are live containers — dropping the rows would orphan them. Remove or
 * move the services first.
 * CONSEQUENCE FOR ORG DELETION (verified against Postgres): a single
 * `delete organization` fails if any Service is still assigned to a Server,
 * because Server is 1 hop from Organization but Service is 3 hops
 * (Project -> Environment -> Service), so the Restrict check on Server fires
 * before the cascade reaches Service. The org-delete service method must delete
 * the org's Projects first, then the Organization row, inside one transaction.
 * That ordering is what you want anyway: teardown of live containers belongs
 * before Warden forgets the servers.
 * - Membership -> User: a user with memberships can't be hard-deleted. Account
 * deletion isn't a Phase 1 flow; revisit when it is.
 * SetNull:
 * - User -> Organization: org deletion leaves the user account behind, unattached.
 * - AuditLog -> User / ApiToken: the log row survives deletion of the actor;
 * performedByEmail / performedByRole / apiTokenName snapshots keep it readable.
 * Tenancy guard: Environment, Service, Server, SshKey and ApiToken all carry
 * organizationId, and the cross-model relations (Environment->Project,
 * Service->Environment, Service->Server, Server->SshKey, ApiToken->Project) are
 * COMPOSITE foreign keys on (id, organizationId). Postgres therefore rejects any
 * row that points at a parent in a different organization, even if the app
 * forgets to check. The @@unique([id, organizationId]) pairs exist only to be
 * referenced by those composite FKs.
 * Indexes: Postgres does NOT auto-index FK columns and neither does Prisma, so every
 * FK has one here. Time-series children index (serverId, createdAt) so range queries
 * and the 24h retention purge stay cheap. Where a @@unique already leads with the FK
 * column (e.g. Project [organizationId, slug]) that index covers it, no duplicate.
 */

enum Role {
  ADMIN
  DEVELOPER
  DEV_OPS
  VIEWER
}

enum PlatformRole {
  OWNER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum DeploymentStatus {
  QUEUED 
  BUILDING
  DEPLOYING 
  HEALTH_CHECK 
  SUCCESS
  GATE_FAILED 
  ROLLED_BACK 
  FAILED 
  CANCELLED
}

enum ServiceType {
  APPLICATION 
  WORKER 
  DATABASE
  COMPOSE
}

enum ServiceStatus {
  NOT_DEPLOYED
  DEPLOYING
  HEALTHY
  DEGRADED
  FAILED
}

enum ServerType {
  BUILD
  DEPLOY
}

enum ServerStatus {
  CONNECTED
  IDLE
  OFFLINE
}

enum DeploymentType {
  MANUAL
  AUTOMATED
}

enum AuthProvider {
  GOOGLE
  GITHUB
  EMAIL
}

enum ApiTokenScope {
  READ
  DEPLOY
  ADMIN
}

enum NotificationChannelType {
  SLACK
  EMAIL
  DISCORD
}

model User {
  id              String        @id @default(uuid())
  firstName       String
  lastName        String
  email           String        @unique
  passwordHashed  String?
  authProcess     AuthProvider  @default(EMAIL)
  googleAccountId String?       @unique
  githubAccountId String?       @unique
  platformRole    PlatformRole?
  memberships     Membership[]
  auditLogs       AuditLog[]
  setInvitations  Invitation[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String           @unique
  role           Role             @default(VIEWER)
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  invitedBy      User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([invitedById])
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(PENDING)
  lastActiveAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id                   String                @id @default(uuid())
  organizationName     String
  organizationEmail    String                @unique
  slug                 String                @unique
  deployCounter        Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deployments          Deployment[]
  memberships          Membership[]
  projects             Project[]
  sshKeys              SshKey[]
  servers              Server[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  invitations          Invitation[]
  notificationChannels NotificationChannel[]
}

model NotificationChannel {
  id              String                  @id @default(uuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            NotificationChannelType
  name            String
  enabled         Boolean                 @default(true)
  webhookUrl      String?
  emailRecipients String[]
  events          String[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([organizationId])
}

model Project {
  id                 String        @id @default(uuid())
  projectName        String
  slug               String
  projectDescription String?
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments       Environment[]
  apiTokens          ApiToken[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
}

model Environment {
  id              String                @id @default(uuid())
  environmentName String
  branch          String?
  projectId       String
  organizationId  String
  project         Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  services        Service[]
  variables       EnvironmentVariable[]
  createdAt       DateTime              @default(now())

  @@unique([projectId, environmentName])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model Service {
  id             String            @id @default(uuid())
  serviceName    String
  type           ServiceType       @default(APPLICATION)
  githubRepoUrl  String?
  branch         String?
  image          String?
  port           Int?
  status         ServiceStatus     @default(NOT_DEPLOYED)
  environmentId  String
  organizationId String
  environment    Environment       @relation(fields: [environmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  serverId       String?
  server         Server?           @relation(fields: [serverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  deployments    Deployment[]
  variables      ServiceVariable[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([environmentId, serviceName])
  @@unique([id, organizationId])
  @@index([serverId])
  @@index([organizationId])
}

model EnvironmentVariable {
  id             String      @id @default(uuid())
  key            String
  valueEncrypted String
  isSecret       Boolean     @default(true)
  environmentId  String
  organizationId String
  environment    Environment @relation(fields: [environmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([environmentId, key])
  @@index([organizationId])
}

model ServiceVariable {
  id             String   @id @default(uuid())
  key            String
  valueEncrypted String
  isSecret       Boolean  @default(true)
  serviceId      String
  organizationId String
  service        Service  @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([serviceId, key])
  @@index([organizationId])
}

model Deployment {
  id               String              @id @default(uuid())
  number           Int
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deploymentStatus DeploymentStatus    @default(QUEUED)
  deploymentType   DeploymentType      @default(MANUAL)
  branch           String?
  commitSha        String?
  serviceId        String
  service          Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  history          DeploymentHistory[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, number])
  @@index([serviceId, createdAt])
  @@index([organizationId, createdAt])
}

model DeploymentHistory {
  id           String           @id @default(uuid())
  deploymentId String
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status       DeploymentStatus
  message      String?
  createdAt    DateTime         @default(now())

  @@index([deploymentId, createdAt])
}

model Server {
  id                    String              @id @default(uuid())
  serverName            String
  serverIp              String
  serverPort            Int
  serverSSHUsername     String
  serverType            ServerType          @default(DEPLOY)
  status                ServerStatus        @default(OFFLINE)
  lastSeenAt            DateTime?
  serverSshKeyId        String
  serverSshKey          SshKey              @relation(fields: [serverSshKeyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  serverLocation        String?
  provider              String?
  dockerCleanupEnabled  Boolean             @default(false)
  dockerCleanupInterval Int?                @default(30)
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services              Service[]
  serverMetrics         ServerMetrics[]
  serverContainers      ServerContainer[]
  serverLogs            ServerLogs[]
  serverTraefik         ServerTraefik[]
  dockerCleanupLogs     DockerCleanupLog[]
  dockerDiskMetrics     DockerDiskMetrics[]
  lastUsedAt            DateTime?
  createdAt             DateTime            @default(now())

  @@unique([organizationId, serverIp, serverPort])
  @@unique([id, organizationId])
  @@index([serverSshKeyId])
}

model ServerMetrics {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage    Float
  memoryUsage Float
  diskUsage   Float
  createdAt   DateTime @default(now())

  @@index([serverId, createdAt])
}

model DockerCleanupLog {
  id        String   @id @default(uuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model DockerDiskMetrics {
  id              String   @id @default(uuid())
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  totalDiskUsage  Float
  imageSize       Float
  volumeSize      Float
  buildCacheSize  Float
  containerSize   Float
  reclaimableSize Float
  createdAt       DateTime @default(now())

  @@index([serverId, createdAt])
}

model ServerContainer {
  id                   String    @id @default(uuid())
  serverId             String
  server               Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  containerName        String
  containerStatus      String
  containerCpuUsage    Float
  containerMemoryUsage Float
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  @@index([serverId, createdAt])
}

model ServerLogs {
  id         String   @id @default(uuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  logMessage String
  createdAt  DateTime @default(now())

  @@index([serverId, createdAt])
}

model ServerTraefik {
  id            String   @id @default(uuid())
  serverId      String
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  traefikConfig String
  createdAt     DateTime @default(now())

  @@index([serverId, createdAt])
}

model SshKey {
  id                  String       @id @default(uuid())
  sshKeyName          String
  publicKey           String
  privateKeyEncrypted String
  servers             Server[]
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  lastUsedAt          DateTime?

  @@unique([id, organizationId])
  @@index([organizationId])
}

model ApiToken {
  id             String        @id @default(uuid())
  apiName        String
  tokenHash      String        @unique
  tokenPrefix    String
  apiTokenScope  ApiTokenScope @default(READ)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId])
}

model AuditLog {
  id               String       @id @default(uuid())
  action           String
  entityType       String
  entityId         String
  performedById    String?
  performedBy      User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedByEmail String?
  performedByRole  Role?
  apiTokenId       String?
  apiToken         ApiToken?    @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  apiTokenName     String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([performedById])
  @@index([apiTokenId])
  @@index([entityType, entityId])
}
