generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * Relationships:
 * 1 user belongs to 1 organization (Phase 1 — single-org-per-user; Membership is
 * already shaped so multi-org later just means allowing >1 Membership row per user)
 * 1 organization has many projects, sshKeys, servers, apiTokens, memberships,
 * invitations, notificationChannels, auditLogs
 * 1 project has many environments, apiTokens
 * 1 environment has many services
 * 1 service has many deployments
 * 1 service has 0..1 githubRepoUrl (repo lives on the SERVICE, not the project —
 * two services may share one repo or have their own)
 * 1 environment has many environmentVariables; 1 service has many serviceVariables
 * (service-level overrides environment-level on the same key)
 * 1 service runs on 0..1 server (via serverId — assigned after creation, not on the
 * project-creation form); 1 server runs many services, from any project in the org
 * 1 server belongs to 1 organization (not locked to a single project — a server
 * can run services from more than one project)
 * 1 server has 1 sshKey (via serverSshKeyId); 1 sshKey can be reused across servers
 * 1 auditLog is performed by 0..1 user (nullable + snapshot fields so the log
 * outlives the user)
 * Cascade behavior: deleting an Organization deletes everything under it
 * (projects, servers, keys, tokens, memberships, invitations, notification
 * channels, audit logs) and deleting a Server deletes its metrics/logs/
 * containers/traefik config/docker data — these are pure child records with no
 * standalone meaning. This is a deliberate choice for Phase 1 (simple, no orphaned
 * data) — revisit if you want a "soft delete with grace period" pattern instead
 * before this ships to real users with real infra on the line.
 * Restrict (delete is blocked; the app must catch Prisma error P2003 and tell the
 * user what is still referencing the row):
 * - Server -> SshKey: a key still used by a server can't be deleted. Reassign first.
 * - Service -> Server: a server still running services can't be deleted. Those
 * services are live containers — dropping the rows would orphan them. Remove or
 * move the services first.
 * CONSEQUENCE FOR ORG DELETION (verified against Postgres): a single
 * `delete organization` fails if any Service is still assigned to a Server,
 * because Server is 1 hop from Organization but Service is 3 hops
 * (Project -> Environment -> Service), so the Restrict check on Server fires
 * before the cascade reaches Service. The org-delete service method must delete
 * the org's Projects first, then the Organization row, inside one transaction.
 * That ordering is what you want anyway: teardown of live containers belongs
 * before Warden forgets the servers.
 * - Membership -> User: a user with memberships can't be hard-deleted. Account
 * deletion isn't a Phase 1 flow; revisit when it is.
 * SetNull:
 * - User -> Organization: org deletion leaves the user account behind, unattached.
 * - AuditLog -> User / ApiToken: the log row survives deletion of the actor;
 * performedByEmail / performedByRole / apiTokenName snapshots keep it readable.
 * Tenancy guard: Environment, Service, Server, SshKey and ApiToken all carry
 * organizationId, and the cross-model relations (Environment->Project,
 * Service->Environment, Service->Server, Server->SshKey, ApiToken->Project) are
 * COMPOSITE foreign keys on (id, organizationId). Postgres therefore rejects any
 * row that points at a parent in a different organization, even if the app
 * forgets to check. The @@unique([id, organizationId]) pairs exist only to be
 * referenced by those composite FKs.
 * Indexes: Postgres does NOT auto-index FK columns and neither does Prisma, so every
 * FK has one here. Time-series children index (serverId, createdAt) so range queries
 * and the 24h retention purge stay cheap. Where a @@unique already leads with the FK
 * column (e.g. Project [organizationId, slug]) that index covers it, no duplicate.
 */

enum Role {
  ADMIN
  DEVELOPER
  DEV_OPS
  VIEWER
}

enum PlatformRole {
  OWNER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  HEALTH_CHECK
  SUCCESS
  GATE_FAILED
  ROLLED_BACK
  FAILED
  CANCELLED
}

enum ServiceType {
  APPLICATION
  WORKER
  DATABASE
  COMPOSE
}

enum ServiceStatus {
  NOT_DEPLOYED
  DEPLOYING
  HEALTHY
  DEGRADED
  FAILED
  /// Stopped on purpose (Stop button): the live version's container is kept, just not running.
  STOPPED
}

enum ServerType {
  BUILD
  DEPLOY
}

enum BackupStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum BackupStorageKind {
  PLATFORM
  ORG
}

enum DatabaseEngine {
  POSTGRES
  MYSQL
  REDIS
}

enum CleanupStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum ServerStatus {
  CONNECTED
  IDLE
  OFFLINE
}

enum DeploymentType {
  MANUAL
  AUTOMATED
}

/// How a deploy's image was made. A rollback that reuses a kept image copies
/// the original's method.
enum BuildMethod {
  DOCKERFILE
  RAILPACK
}

enum AuthProvider {
  GOOGLE
  GITHUB
  EMAIL
}

enum ApiTokenScope {
  READ
  DEPLOY
  ADMIN
}

enum NotificationChannelType {
  SLACK
  EMAIL
  DISCORD
}

model User {
  id                   String             @id @default(uuid())
  firstName            String
  lastName             String
  email                String             @unique
  passwordHashed       String?
  authProcess          AuthProvider       @default(EMAIL)
  googleAccountId      String?            @unique
  githubAccountId      String?            @unique
  platformRole         PlatformRole?
  /// DiceBear style id + seed. Null = a default derived from the user id (see the api's auth.mapper).
  avatarStyle          String?
  avatarSeed           String?
  memberships          Membership[]
  auditLogs            AuditLog[]
  setInvitations       Invitation[]
  deploymentsTriggered Deployment[]
  dockerCleanups       DockerCleanupLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  proxyConfigs         ServerTraefik[]
}

model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String           @unique
  role           Role             @default(VIEWER)
  status         InvitationStatus @default(PENDING)
  invitedById    String?
  invitedBy      User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([invitedById])
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(PENDING)
  lastActiveAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id                   String                @id @default(uuid())
  organizationName     String
  organizationEmail    String                @unique
  slug                 String                @unique
  deployCounter        Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  dataKeyWrapped       String
  deployments          Deployment[]
  memberships          Membership[]
  projects             Project[]
  sshKeys              SshKey[]
  servers              Server[]
  apiTokens            ApiToken[]
  auditLogs            AuditLog[]
  invitations          Invitation[]
  notificationChannels NotificationChannel[]
  serviceDatabases     ServiceDatabase[]
  backupStorage        BackupStorage?
  databaseBackups      DatabaseBackup[]
  githubInstallations  GithubInstallation[]
}

model NotificationChannel {
  id                  String                  @id @default(uuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                NotificationChannelType
  name                String
  enabled             Boolean                 @default(true)
  webhookUrlEncrypted String?
  emailRecipients     String[]
  events              String[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Project {
  id                 String        @id @default(uuid())
  projectName        String
  slug               String
  projectDescription String?
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments       Environment[]
  apiTokens          ApiToken[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
}

model Environment {
  id              String                @id @default(uuid())
  environmentName String
  branch          String?
  projectId       String
  organizationId  String
  project         Project               @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  services        Service[]
  variables       EnvironmentVariable[]
  /// Where new services and databases in this environment go, unless one
  /// picks another. Apps must sit next to their databases (private network),
  /// so one default per environment keeps them together. Restrict: a server
  /// that's still some environment's default can't be deleted.
  defaultServerId String?
  defaultServer   Server?               @relation("EnvironmentDefaultServer", fields: [defaultServerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@unique([projectId, environmentName])
  @@unique([id, organizationId])
  @@index([defaultServerId, organizationId])
  @@index([organizationId])
}

model Service {
  id                   String              @id @default(uuid())
  serviceName          String
  type                 ServiceType         @default(APPLICATION)
  githubRepoUrl        String?
  branch               String?
  image                String?
  port                 Int?
  status               ServiceStatus       @default(NOT_DEPLOYED)
  // ── Phase 2 build settings (APPLICATION / WORKER) ──
  /// Which GitHub App installation can read the repo. Null = a public repo,
  /// cloned without a key. Single-column FK with SetNull (uninstalling the App
  /// must not delete services); the org is checked in code when it's set.
  githubInstallationId String?
  githubInstallation   GithubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  /// GitHub's numeric repo id: survives renames, and is what push webhooks carry.
  githubRepoId         Int?
  /// Folder the build starts in ("" = repo root, so a monorepo's shared packages are visible).
  rootDirectory        String              @default("")
  /// Relative to rootDirectory. Used when that file exists; otherwise Railpack.
  dockerfilePath       String              @default("Dockerfile")
  /// Railpack overrides (e.g. "pnpm turbo build --filter=api").
  buildCommand         String?
  startCommand         String?
  /// A website's built folder (e.g. "apps/frontend/dist"): Railpack serves it
  /// as static files on $PORT. Needed when the site isn't at the repo root.
  staticOutputDir      String?
  /// Run once in the new image before it goes live (e.g. "npx prisma migrate deploy").
  releaseCommand       String?
  healthCheckPath      String              @default("/")
  /// A push deploys this service only if it changed a file matching one of these (empty = any change).
  watchPaths           String[]
  autoDeploy           Boolean             @default(true)
  domains              ServiceDomain[]
  /// Where the box sits on the environment's canvas, shared by the whole team.
  /// Null = never placed, so the canvas auto-places it in a free grid spot.
  canvasX              Float?
  canvasY              Float?
  environmentId        String
  organizationId       String
  environment          Environment         @relation(fields: [environmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  serverId             String?
  server               Server?             @relation(fields: [serverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  deployments          Deployment[]
  variables            ServiceVariable[]
  database             ServiceDatabase?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([environmentId, serviceName])
  @@unique([id, organizationId])
  @@index([serverId])
  @@index([organizationId])
  @@index([githubInstallationId])
  @@index([githubRepoId])
}

model EnvironmentVariable {
  id             String      @id @default(uuid())
  key            String
  valueEncrypted String
  isSecret       Boolean     @default(true)
  environmentId  String
  organizationId String
  environment    Environment @relation(fields: [environmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([environmentId, key])
  @@index([organizationId])
}

model ServiceVariable {
  id             String   @id @default(uuid())
  key            String
  valueEncrypted String
  isSecret       Boolean  @default(true)
  serviceId      String
  organizationId String
  service        Service  @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([serviceId, key])
  @@index([organizationId])
}

model Deployment {
  id               String              @id @default(uuid())
  number           Int
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deploymentStatus DeploymentStatus    @default(QUEUED)
  deploymentType   DeploymentType      @default(MANUAL)
  branch           String?
  commitSha        String?
  commitMessage    String?
  // Who started it. SetNull keeps the deploy when the user is deleted; the
  // name is a snapshot (also covers API tokens: "token: github-actions").
  triggeredById    String?
  triggeredBy      User?               @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  triggeredByName  String?
  startedAt        DateTime? // left the queue; createdAt is when it was queued
  finishedAt       DateTime? // reached a final status
  /// "warden/<service id8>:<number>". The last 3 per service stay on the server for instant rollbacks.
  imageTag         String?
  buildMethod      BuildMethod?
  /// Set on a rollback: the deploy whose image/commit it brings back.
  rollbackOfId     String?
  rollbackOf       Deployment?         @relation("Rollback", fields: [rollbackOfId], references: [id], onDelete: SetNull)
  rollbacks        Deployment[]        @relation("Rollback")
  /// The container this deploy started ("warden-app-<id8>-<number>").
  containerName    String?
  logs             DeploymentLog[]
  serviceId        String
  service          Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  history          DeploymentHistory[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, number])
  @@index([triggeredById])
  @@index([rollbackOfId])
  @@index([serviceId, createdAt])
  @@index([organizationId, createdAt])
}

/// A deploy's output (clone, build, app start), in chunks of lines, in order.
/// Pruned after 30 days. Live viewers get the same lines over Socket.io.
model DeploymentLog {
  id           String     @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  seq          Int
  text         String
  createdAt    DateTime   @default(now())

  @@unique([deploymentId, seq])
  @@index([createdAt])
}

model DeploymentHistory {
  id           String           @id @default(uuid())
  deploymentId String
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status       DeploymentStatus
  message      String?
  createdAt    DateTime         @default(now())

  @@index([deploymentId, createdAt])
}

model Server {
  id                    String              @id @default(uuid())
  serverName            String
  serverIp              String
  serverPort            Int
  serverSSHUsername     String
  serverType            ServerType          @default(DEPLOY)
  status                ServerStatus        @default(OFFLINE)
  lastSeenAt            DateTime?
  serverSshKeyId        String
  serverSshKey          SshKey              @relation(fields: [serverSshKeyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  serverLocation        String?
  provider              String?
  dockerCleanupEnabled  Boolean             @default(false)
  dockerCleanupInterval Int?                @default(30)
  /// When Warden last set up Traefik (the front door on ports 80/443). Null = not set up.
  proxyInstalledAt      DateTime?
  /// Which Traefik setup it has. 2 = can take warden.yml (the config editor).
  proxyRevision         Int?
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services              Service[]
  defaultFor            Environment[]       @relation("EnvironmentDefaultServer")
  serverMetrics         ServerMetrics[]
  serverContainers      ServerContainer[]
  serverLogs            ServerLogs[]
  serverTraefik         ServerTraefik[]
  dockerCleanupLogs     DockerCleanupLog[]
  dockerDiskMetrics     DockerDiskMetrics[]
  lastUsedAt            DateTime?
  createdAt             DateTime            @default(now())

  @@unique([organizationId, serverIp, serverPort])
  @@unique([id, organizationId])
  @@index([serverSshKeyId])
}

/// One row per poll (every 60s) from the worker. Percentages for the charts,
/// bytes for "used / total", load averages straight from /proc/loadavg.
model ServerMetrics {
  id               String   @id @default(uuid())
  serverId         String
  server           Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuUsage         Float
  memoryUsage      Float
  diskUsage        Float
  memoryUsedBytes  Float
  memoryTotalBytes Float
  diskUsedBytes    Float
  diskTotalBytes   Float
  load1            Float
  load5            Float
  load15           Float
  createdAt        DateTime @default(now())

  @@index([serverId, createdAt])
}

/// One row per cleanup run: created QUEUED by the api, moved through RUNNING
/// to SUCCESS or FAILED by the worker.
model DockerCleanupLog {
  id             String        @id @default(uuid())
  serverId       String
  server         Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status         CleanupStatus @default(QUEUED)
  reclaimedBytes Float?
  errorMessage   String?
  /// Null = started by Warden itself, or the user has since been deleted.
  triggeredById  String?
  triggeredBy    User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([serverId, createdAt])
  @@index([triggeredById])
}

model DockerDiskMetrics {
  id              String   @id @default(uuid())
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  totalDiskUsage  Float
  imageSize       Float
  volumeSize      Float
  buildCacheSize  Float
  containerSize   Float
  reclaimableSize Float
  createdAt       DateTime @default(now())

  @@index([serverId, createdAt])
}

/// What is on the server NOW: one row per Docker container, upserted on every
/// poll and deleted when the container is gone. Current state, not history.
model ServerContainer {
  id                   String   @id @default(uuid())
  serverId             String
  server               Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  dockerId             String
  containerName        String
  image                String
  /// Docker's state: running, exited, restarting, paused, created, dead
  state                String
  /// From the container's HEALTHCHECK, when it has one: healthy, unhealthy, starting
  health               String?
  /// Docker's own wording, e.g. "Up 3 hours"
  statusText           String
  /// docker stats CPU %, can pass 100 on multi-core hosts. Null when not running.
  containerCpuUsage    Float?
  /// Bytes. Null when not running.
  containerMemoryUsage Float?
  containerMemoryLimit Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Also serves as the serverId index (it's the leading column).
  @@unique([serverId, dockerId])
}

model ServerLogs {
  id         String   @id @default(uuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  logMessage String
  createdAt  DateTime @default(now())

  @@index([serverId, createdAt])
}

/// One version of a server's warden.yml (server page → Proxy). Every save is
/// a new row, so any version can be brought back. Rows are only reachable
/// through their server, which is checked against the org.
model ServerTraefik {
  id            String            @id @default(uuid())
  serverId      String
  server        Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The full warden.yml that was written.
  traefikConfig String
  /// What it was made from: the form's settings and the free YAML.
  form          Json?
  raw           String            @default("")
  status        ProxyConfigStatus @default(APPLIED)
  source        ProxyConfigSource @default(RAW)
  /// Traefik's complaints when it was rolled back ([{ where, line, message }]).
  problems      Json?
  note          String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt     DateTime          @default(now())

  @@index([serverId, createdAt])
  @@index([createdById])
}

enum ProxyConfigStatus {
  APPLIED
  ROLLED_BACK
}

enum ProxyConfigSource {
  FORM
  RAW
  REVERT
}

model SshKey {
  id                  String       @id @default(uuid())
  sshKeyName          String
  fingerprint         String
  publicKey           String
  privateKeyEncrypted String
  servers             Server[]
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  lastUsedAt          DateTime?

  @@unique([id, organizationId])
  @@unique([organizationId, sshKeyName])
  @@index([organizationId])
}

model ApiToken {
  id             String        @id @default(uuid())
  apiName        String
  tokenHash      String        @unique
  tokenPrefix    String
  apiTokenScope  ApiTokenScope @default(READ)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  auditLogs      AuditLog[]
  createdAt      DateTime      @default(now())

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId])
}

model AuditLog {
  id               String       @id @default(uuid())
  action           String
  entityType       String
  entityId         String
  metadata         Json?
  performedById    String?
  performedBy      User?        @relation(fields: [performedById], references: [id], onDelete: SetNull)
  performedByEmail String?
  performedByRole  Role?
  apiTokenId       String?
  apiToken         ApiToken?    @relation(fields: [apiTokenId], references: [id], onDelete: SetNull)
  apiTokenName     String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set for project-scoped events (project, environment, variable), for the
  /// project's Activity tab. No foreign key on purpose: a "project deleted"
  /// row must outlive the project, like the actor snapshot columns.
  projectId        String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([performedById])
  @@index([apiTokenId])
  @@index([entityType, entityId])
}

/// A database service's engine details (one per Service of type DATABASE).
/// The container runs on the service's server, on a private Docker network
/// per environment, with its data in a named volume. Never a published port.
model ServiceDatabase {
  id                    String           @id @default(uuid())
  serviceId             String           @unique
  organizationId        String
  service               Service          @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engine                DatabaseEngine
  version               String
  /// Null for Redis (no database or user concept).
  databaseName          String?
  username              String?
  /// encrypt(password, orgDek, 'v1'), like variables. Never returned.
  passwordEncrypted     String
  /// MySQL only: its separate root password.
  rootPasswordEncrypted String?
  containerName         String
  volumeName            String
  networkName           String
  /// The auto-created environment variable holding the connection string.
  variableName          String
  environmentVariableId String?
  /// Backups (item 18b). Hour is UTC; the UI shows local time.
  backupEnabled         Boolean          @default(true)
  backupHourUtc         Int              @default(2)
  backupRetentionDays   Int              @default(7)
  backups               DatabaseBackup[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([serviceId, organizationId])
  @@index([organizationId])
}

/// An org's own S3-compatible bucket for database backups (e.g. its own
/// Cloudflare R2). When set, it's used instead of Warden's platform bucket.
model BackupStorage {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint        String
  bucket          String
  accessKeyId     String
  /// encrypt(secret, orgDek, 'v1'). Never returned.
  secretEncrypted String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

/// One backup of one database. The file is encrypted with the org's key
/// (AES-256-GCM: iv + authTag kept here) before it leaves the worker.
model DatabaseBackup {
  id             String            @id @default(uuid())
  serviceId      String
  organizationId String
  database       ServiceDatabase   @relation(fields: [serviceId, organizationId], references: [serviceId, organizationId], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         BackupStatus      @default(QUEUED)
  trigger        BackupTrigger
  /// Which bucket it went to, so it stays downloadable after the org switches storage.
  storage        BackupStorageKind
  bucket         String?
  objectKey      String?
  sizeBytes      Float?
  iv             String?
  authTag        String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([serviceId, createdAt])
  @@index([organizationId])
}

/// A GitHub account/org that installed the Warden GitHub App for this org.
model GithubInstallation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// GitHub's installation id (what tokens are minted for).
  installationId Int
  accountLogin   String
  accountType    String
  services       Service[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, installationId])
  @@index([installationId])
}

/// A custom domain on a service (Stage 8). sslip.io addresses aren't stored:
/// they're worked out from the server's IP, so they follow an IP change.
model ServiceDomain {
  id             String    @id @default(uuid())
  serviceId      String
  organizationId String
  service        Service   @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Lowercase, unique across Warden: two services can't answer for one name.
  domain         String    @unique
  /// Last time its DNS pointed at the service's server.
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([serviceId, organizationId])
}
