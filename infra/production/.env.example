# Warden's settings on its own server. Copy to .env (install.sh does), fill in,
# and keep a copy of MASTER_KEY somewhere safe OFF this server: it encrypts every
# SSH key and database password Warden stores. Lose it and they're unreadable.

# Where the dashboard lives. Its DNS A record must point at this server.
WARDEN_HOST=app.trywarden.xyz
# Only redirects to https://WARDEN_HOST/platform (the platform owner's page). Required:
# it needs its own DNS A record to this server for its certificate. install.sh
# fills in admin.<your domain>; an existing .env must add this line before update.sh.
ADMIN_HOST=admin.trywarden.xyz
# Image tag to run: latest, or a commit's sha to pin a version.
WARDEN_VERSION=latest

# Generated by install.sh (openssl rand -hex 32). Never change MASTER_KEY once used.
POSTGRES_PASSWORD=
MASTER_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email (sign-in links, invites, alerts). Empty = links are only printed in the api's log.
RESEND_API_KEY=
MAIL_FROM=Warden <noreply@trywarden.xyz>
# Where the dashboard's Support form sends messages (and the "Questions?" line in emails).
# Empty = no Support button.
MAIL_SUPPORT=

# Sign in with GitHub (an OAuth app; its callback is https://WARDEN_HOST/api/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The Warden GitHub App (private repos, deploy on push). Empty = public repos only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
# One line, with \n for the line breaks.
GITHUB_APP_PRIVATE_KEY=

# Warden's own bucket for database backups (Cloudflare R2 or any S3-compatible store).
# Also where backup.sh puts Warden's own nightly database dump.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
