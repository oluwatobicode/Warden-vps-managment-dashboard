---
// The docs home below the hero: four places to start, then every section of
// the sidebar laid out as a directory. Read from the sidebar itself, so a new
// page shows up here without touching this file.
import { getCollection } from "astro:content";
import type { SidebarEntry } from "@astrojs/starlight/utils/routing/types";

// id → the label shown here (a page's own title can be too short out of context).
const START: Array<[id: string, label?: string]> = [
  ["quick-start"],
  ["servers/add-a-server"],
  ["deploying/from-github"],
  ["self-hosting/install", "Self-host Warden"],
];

const docs = await getCollection("docs");
const byId = new Map(docs.map((d) => [d.id, d]));
const start = START.flatMap(([id, label]) => {
  const d = byId.get(id);
  return d ? [{ href: `/${d.id}/`, title: label ?? d.data.title, description: d.data.description }] : [];
});

const links = (entries: SidebarEntry[]): Array<{ label: string; href: string }> =>
  entries.flatMap((e) => (e.type === "link" ? [{ label: e.label, href: e.href }] : links(e.entries)));
const sections = Astro.locals.starlightRoute.sidebar
  .filter((e) => e.type === "group")
  .map((g) => ({ label: g.label, links: links(g.entries) }));
---

<section class="start not-content" aria-labelledby="start-here">
  <h2 id="start-here">Start here</h2>
  <ol>
    {
      start.map((d) => (
        <li>
          <a href={d.href}>
            <span class="t">{d.title}</span>
            <span class="d">{d.description}</span>
            <svg class="arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<section class="all not-content" aria-labelledby="everything">
  <h2 id="everything">Everything in the docs</h2>
  <div class="cols">
    {
      sections.map((s) => (
        <div class="col">
          <h3>{s.label}</h3>
          <ul>
            {s.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    margin-top: 0;
  }
  h2 {
    margin: 0 0 1rem;
    font-family: var(--w-display);
    font-size: var(--sl-text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .start ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 8px;
    background: var(--w-panel);
    box-shadow: inset 0 0 0 1px var(--w-hair);
  }
  .start li + li {
    border-top: 1px solid var(--w-hair);
    margin: 0;
  }
  .start a {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    text-decoration: none;
  }
  .start .t {
    color: var(--sl-color-white);
    font-weight: 500;
  }
  .start .d {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .start .arrow {
    color: var(--sl-color-gray-4);
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), color 160ms;
  }
  .start a:hover .arrow,
  .start a:focus-visible .arrow {
    color: var(--sl-color-white);
    transform: translateX(3px);
  }
  .start a:hover .t {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--w-hair-strong);
  }

  .all {
    margin-top: 3.5rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 2rem 2.5rem;
  }
  h3 {
    margin: 0 0 0.625rem;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col li {
    margin: 0;
  }
  .col a {
    display: inline-block;
    padding: 0.1875rem 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 40rem) {
    .start a {
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
    }
    .start .d {
      grid-column: 1;
    }
    .start .arrow {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }
</style>
