---
// The page title with where-you-are above it (Databases › Backups) and a
// "Copy page" menu beside it: the page's Markdown, or the page opened in
// ChatGPT / Claude.
import type { SidebarEntry } from "@astrojs/starlight/utils/routing/types";

const PAGE_TITLE_ID = "_top";
const { entry, sidebar } = Astro.locals.starlightRoute;
const title = entry.data.title;

/** The sidebar group that holds the current page, if any. */
function groupOf(entries: SidebarEntry[], parent?: string): string | undefined {
  for (const e of entries) {
    if (e.type === "link" && e.isCurrent) return parent;
    if (e.type === "group") {
      const found = groupOf(e.entries, e.label);
      if (found) return found;
    }
  }
}
const group = groupOf(sidebar);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ask = `Read ${pageUrl} so I can ask you questions about it.`;
const chatgpt = `https://chatgpt.com/?hints=search&q=${encodeURIComponent(ask)}`;
const claude = `https://claude.ai/new?q=${encodeURIComponent(ask)}`;
const markdown = `# ${title}\n\n${entry.body ?? ""}`.trim();
---

<div class="page-head">
  {
    group && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Docs</a>
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
        <span>{group}</span>
      </nav>
    )
  }
  <div class="title-row">
    <h1 id={PAGE_TITLE_ID}>{title}</h1>
    <div class="copy print:hidden">
      <button type="button" class="copy-main" data-copy-page>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
        <span data-copy-label>Copy page</span>
      </button>
      <details class="copy-more">
        <summary aria-label="More ways to use this page">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="menu" role="menu">
          <button type="button" role="menuitem" data-copy-page>
            <strong>Copy page</strong>
            <span>As Markdown, for an AI chat</span>
          </button>
          <a role="menuitem" href={chatgpt} target="_blank" rel="noopener noreferrer">
            <strong>Open in ChatGPT <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></strong>
            <span>Ask questions about this page</span>
          </a>
          <a role="menuitem" href={claude} target="_blank" rel="noopener noreferrer">
            <strong>Open in Claude <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></strong>
            <span>Ask questions about this page</span>
          </a>
        </div>
      </details>
      <template data-page-markdown set:text={markdown} />
    </div>
  </div>
  {entry.data.description && <p class="lede">{entry.data.description}</p>}
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-page]")) {
    btn.addEventListener("click", async () => {
      const root = btn.closest(".copy");
      const text = root?.querySelector("template")?.innerHTML ?? "";
      const label = root?.querySelector<HTMLElement>("[data-copy-label]");
      const md = new DOMParser().parseFromString(text, "text/html").documentElement.textContent ?? "";
      try {
        await navigator.clipboard.writeText(md);
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Couldn't copy";
      }
      root?.querySelector("details")?.removeAttribute("open");
      setTimeout(() => label && (label.textContent = "Copy page"), 2000);
    });
  }
  // Close the menu on an outside click or Escape.
  document.addEventListener("click", (e) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>(".copy-more[open]")) {
      if (!d.contains(e.target as Node)) d.removeAttribute("open");
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") document.querySelectorAll(".copy-more[open]").forEach((d) => d.removeAttribute("open"));
  });
</script>

<style>
  .page-head {
    margin-top: 0.5rem;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.875rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .crumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--sl-color-white);
  }
  .crumbs span {
    color: var(--sl-color-gray-2);
  }
  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  h1 {
    margin: 0;
    font-family: var(--w-display);
    font-size: var(--sl-text-h1);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .lede {
    margin-top: 0.75rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    max-width: 38rem;
    text-wrap: pretty;
  }

  .copy {
    position: relative;
    display: flex;
    flex-shrink: 0;
    margin-top: 0.25rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--w-hair);
  }
  .copy-main,
  .copy-more summary {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    height: 2rem;
    padding: 0 0.6875rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    cursor: pointer;
  }
  .copy-main:hover,
  .copy-more summary:hover {
    color: var(--sl-color-white);
  }
  .copy-more summary {
    padding: 0 0.5rem;
    border-inline-start: 1px solid var(--w-hair);
    list-style: none;
  }
  .copy-more summary::-webkit-details-marker {
    display: none;
  }
  .menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.375rem);
    z-index: 20;
    width: 16rem;
    padding: 0.3125rem;
    border-radius: 8px;
    background: var(--w-panel);
    box-shadow:
      inset 0 0 0 1px var(--w-hair),
      0 12px 32px -8px rgb(0 0 0 / 0.5);
  }
  .menu > * {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border: 0;
    border-radius: 5px;
    background: transparent;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .menu > *:hover,
  .menu > *:focus-visible {
    background: var(--w-hover);
  }
  .menu strong {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .menu span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  @media (max-width: 40rem) {
    .copy {
      display: none;
    }
  }
</style>
